# FastCode Skill Configuration
# Copy this file to .env and fill in your values

# LLM Configuration (required for commit review)
LLM_API_KEY=
LLM_PROVIDER=openai  # or "anthropic"
LLM_MODEL=  # or "claude-sonnet-4-20250514"
LLM_BASE_URL= # Optional: proxy URL, e.g., https://api.openai.com/v1

# Embedding Model
# Model will be cached in {skill_dir}/data/model/ by default
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# EMBEDDING_CACHE=/absolute/path/to/models  # Optional: only use absolute path
